# Nova Runtime — copy to .env and edit. All are optional (defaults shown).
# Server
NOVA_URL=http://127.0.0.1:8642/api/v1
# or split:
# NOVA_HOST=127.0.0.1
# NOVA_PORT=8642
# NOVA_PROTOCOL=http
# NOVA_BASE_PATH=/api/v1

# Auth — for SDK (choose one)
# NOVA_TOKEN=nr_xxx...
# NOVA_API_KEY=xxx
# NOVA_USERNAME=admin
# NOVA_PASSWORD=<set NOVA_ADMIN_PASSWORD when starting novad, or use the random password from the boot log>

# Admin bootstrap password for novad (set at first boot)
# NOVA_ADMIN_PASSWORD=your-secure-password

# CLI — overrides --address / --api-key
# NOVA_API_URL=http://127.0.0.1:8642
# NOVA_API_KEY=nr_xxx...

# Logging
RUST_LOG=info
# novad will read NOVA_* envs as TOML overrides: e.g. NOVA_NETWORKING__LISTEN_PORT=8642
